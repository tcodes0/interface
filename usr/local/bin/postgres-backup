set -euo pipefail
# this script must live outside home directories — it runs as the postgres user,
# which cannot access paths under /home/vacation. install to /usr/local/bin.

### vars ###

backup_dir=/var/lib/postgres/backups
timestamp=$(date +%Y%m%d_%H%M%S)

### script ###

mkdir -p "$backup_dir"
pg_dumpall --file="$backup_dir/backup-$timestamp.sql"

# keep newest 10 only
# shellcheck disable=SC2207
old_backups=($(find "$backup_dir" -maxdepth 1 -name 'backup-*.sql' | sort -r | tail -n +11))
((${#old_backups[@]} > 0)) && rm -f "${old_backups[@]}"

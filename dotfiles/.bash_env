#! /usr/bin/env bash
# shellcheck disable=SC1091
# uninteractive bash env
# BASH_ENV must be set to this script in bash config files

# envs
export GOPRIVATE="github.com/eleanorhealth/* github.com/tcodes0/*"
export T0_COLOR=true

# shellcheck source=lib.sh
if ! source "$HOME/Desktop/interface/dotfiles/lib.sh" 2>/dev/null; then
  # shellcheck source=lib.sh
  echo source "$HOME/Desktop/interface/dotfiles/lib.sh": not found
fi

# shellcheck source=.functions_env.sh
if ! source "$HOME/Desktop/interface/dotfiles/.functions_env.sh" 2>/dev/null; then
  # shellcheck source=.functions_env.sh
  echo source "$HOME/Desktop/interface/dotfiles/.functions_env.sh": not found
fi

export PATH="$PATH:$HOME/bin"

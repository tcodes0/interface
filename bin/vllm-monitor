#!/usr/bin/env python3
"""Monitor vLLM metrics and recent errors in a log file."""

from __future__ import annotations

import argparse
import importlib.util
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request
from pathlib import Path
from typing import Iterable


def ensure_dependencies() -> None:
    if importlib.util.find_spec("rich") is not None:
        return

    print("Installing required dependency: rich", file=sys.stderr)
    pip_command = [
        sys.executable,
        "-m",
        "pip",
        "install",
        "--break-system-packages",
        "--quiet",
        "rich",
    ]

    try:
        subprocess.check_call(pip_command)
        return
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

    # Some minimal virtual environments omit pip. Bootstrap it before retrying.
    try:
        bootstrap = urllib.request.urlopen(
            "https://bootstrap.pypa.io/get-pip.py", timeout=30
        ).read()
        subprocess.run([sys.executable, "-"], input=bootstrap, check=True)
        subprocess.check_call(pip_command)
    except (OSError, subprocess.CalledProcessError) as error:
        raise SystemExit(
            "Could not install 'rich'. Try running:\n"
            f"  {sys.executable} -m ensurepip --upgrade\n"
            f"  {sys.executable} -m pip install rich"
        ) from error


ensure_dependencies()

from rich.console import Console, Group  # noqa: E402
from rich.live import Live  # noqa: E402
from rich.table import Table  # noqa: E402
from rich.text import Text  # noqa: E402

DEFAULT_DIRECTORY = Path(os.environ.get("VLLM_MONITOR_DIRECTORY", "/workspace/logs"))
LOG_PATTERN = re.compile(r"^vllm-(\d{8}-\d{6})\.log$")
TAIL_LINES = int(os.environ.get("VLLM_MONITOR_TAIL_LINES", "20"))
STARTUP_LINE = "Application startup complete."
LIVE_REFRESH_PER_SECOND = float(os.environ.get("VLLM_MONITOR_LIVE_REFRESH_PER_SECOND", "1"))
STARTUP_POLL_INTERVAL = float(os.environ.get("VLLM_MONITOR_STARTUP_POLL_INTERVAL", "0.1"))
DIRECTORY_SAMPLE_INTERVAL = 1.0
MONITORED_DIRECTORIES = tuple(
    Path(path.strip())
    for path in os.environ.get(
        "VLLM_MONITOR_DIRECTORIES", "/workspace/.cache,/workspace/.huggingface"
    ).split(",")
    if path.strip()
)
GPU_STATS_COMMAND = ("nvidia-smi", "dmon", "-s", "pucm", "-d", "1", "-c", "1")

METRIC_PATTERNS = {
    "Generation throughput": re.compile(r"Avg generation throughput:\s*([\d.]+)\s*tokens/s"),
    "KV cache usage": re.compile(r"GPU KV cache usage:\s*([\d.]+)%"),
    "Prefix hit rate": re.compile(r"Prefix cache hit rate:\s*([\d.]+)%"),
    "Mean acceptance length": re.compile(r"Mean acceptance length:\s*([\d.]+)"),
    "Accepted throughput": re.compile(r"Accepted throughput:\s*([\d.]+)\s*tokens/s"),
    "Drafted throughput": re.compile(r"Drafted throughput:\s*([\d.]+)\s*tokens/s"),
    "Accepted tokens": re.compile(r"Accepted:\s*(\d+)\s*tokens"),
    "Drafted tokens": re.compile(r"Drafted:\s*(\d+)\s*tokens"),
    "Draft acceptance": re.compile(r"Avg Draft acceptance rate:\s*([\d.]+)%"),
}
POSITION_PATTERN = re.compile(r"Per-position acceptance rate:\s*([\d.,\s]+)")
HTTP_PATTERN = re.compile(r'"[^"\n]+HTTP/[\d.]+"\s+(\d{3})(?:\s+([^\r\n]*))?')
ERROR_PATTERN = re.compile(r"\bERROR\b|Traceback \(most recent call last\)|(?:Error|Exception):")
GOOD_PATTERN = re.compile(r"\bINFO\b|throughput|cache usage|acceptance rate", re.IGNORECASE)


def choose_log(directory: Path) -> Path:
    candidates = [path for path in directory.glob("vllm-*.log") if LOG_PATTERN.match(path.name)]
    if not candidates:
        raise FileNotFoundError(f"No vllm-YYYYMMDD-HHMMSS.log files found in {directory}")
    return max(candidates, key=lambda path: LOG_PATTERN.match(path.name).group(1))


def read_tail(path: Path) -> list[str]:
    with path.open(encoding="utf-8", errors="replace") as log_file:
        return log_file.readlines()[-TAIL_LINES:]


def format_size(size_mb: int) -> str:
    return f"{size_mb / 1024:.1f}Gb" if size_mb >= 1024 else f"{size_mb}Mb"


class DirectoryMonitor:
    def __init__(self, paths: Iterable[Path]) -> None:
        self.latest = {path: 0 for path in paths}
        self.gpu_stats: list[str] = []
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)

    def start(self) -> None:
        self._thread.start()

    def stop(self) -> None:
        self._stop.set()
        self._thread.join(timeout=DIRECTORY_SAMPLE_INTERVAL + 1)

    def snapshot(self) -> tuple[str, list[str]]:
        with self._lock:
            directory_line = "  ".join(
                f"{path.name}: {format_size(self.latest[path])}" for path in self.latest
            )
            return directory_line, list(self.gpu_stats)

    def _run(self) -> None:
        while not self._stop.is_set():
            try:
                output = subprocess.check_output(
                    GPU_STATS_COMMAND, text=True, stderr=subprocess.DEVNULL
                )
                gpu_stats = []
                for line in output.splitlines():
                    fields = line.split()
                    if len(fields) >= 6 and fields[0].isdigit():
                        gpu_stats.append(
                            f"GPU {fields[0]}: SM {fields[4]}% MEM {fields[5]}%"
                        )
                with self._lock:
                    self.gpu_stats = gpu_stats
            except (OSError, subprocess.CalledProcessError):
                pass
            for path in self.latest:
                try:
                    size = int(subprocess.check_output(["du", "-sm", "--", str(path)], text=True).split()[0])
                except (OSError, subprocess.CalledProcessError, ValueError):
                    size = 0
                with self._lock:
                    self.latest[path] = size
            self._stop.wait(DIRECTORY_SAMPLE_INTERVAL)


def server_started(lines: Iterable[str]) -> bool:
    for line in lines:
        if STARTUP_LINE in line:
            return True
        match = HTTP_PATTERN.search(line)
        if match and 200 <= int(match.group(1)) < 300:
            return True
    return False


def wait_for_startup(path: Path, live: Live, directory_monitor: DirectoryMonitor) -> None:
    while True:
        lines = read_tail(path)
        directory_line, gpu_lines = directory_monitor.snapshot()
        renderable = [Text(f"Monitoring: {path}"), Text(directory_line)]
        renderable.extend(Text(gpu_line) for gpu_line in gpu_lines)
        renderable.append(Text("".join(line for line in lines if STARTUP_LINE not in line)))
        live.update(Group(*renderable))
        if server_started(lines):
            return
        time.sleep(STARTUP_POLL_INTERVAL)


def parse_metrics(lines: Iterable[str]) -> dict[str, str]:
    metrics: dict[str, str] = {}
    for line in lines:
        for label, pattern in METRIC_PATTERNS.items():
            match = pattern.search(line)
            if match:
                value = match.group(1)
                suffix = " tokens/s" if "throughput" in label.lower() else "%" if "rate" in label.lower() or "usage" in label.lower() else ""
                metrics[label] = f"{value}{suffix}"
        match = POSITION_PATTERN.search(line)
        if match:
            values = [float(value) * 100 for value in re.findall(r"\d+(?:\.\d+)?", match.group(1))]
            metrics["Position acceptance"] = ", ".join(f"{value:.1f}%" for value in values)
    return metrics


def error_lines(lines: list[str]) -> list[str]:
    events: list[list[str]] = []
    current: list[str] = []
    for line in lines:
        status_match = HTTP_PATTERN.search(line)
        is_http_error = bool(status_match and int(status_match.group(1)) >= 400)
        is_error = bool(ERROR_PATTERN.search(line)) or is_http_error
        if is_error:
            if current and not (line.lstrip().startswith("call") or line.lstrip().startswith("_")):
                events.append(current)
                current = []
            current.append(line.rstrip("\n"))
        elif current and (line.startswith((" ", "\t")) or not line.startswith("(")):
            current.append(line.rstrip("\n"))
        elif current:
            events.append(current)
            current = []
        elif GOOD_PATTERN.search(line):
            events.clear()
    if current:
        events.append(current)
    return events[-1] if events else []


def render_table(metrics: dict[str, str], log_path: Path) -> Table:
    table = Table(title=f"vLLM monitor — {log_path}", show_header=True, header_style="bold cyan")
    table.add_column("Metric", style="bold")
    table.add_column("Value", justify="right")
    labels = [
        "Generation throughput", "KV cache usage", "Prefix hit rate", "Mean acceptance length",
        "Accepted throughput", "Drafted throughput", "Accepted tokens", "Drafted tokens",
        "Position acceptance", "Draft acceptance",
    ]
    for label in labels:
        table.add_row(label, metrics.get(label, "—"))
    return table


def display(console: Console, path: Path) -> None:
    lines = read_tail(path)
    errors = error_lines(lines)
    console.clear()
    if errors:
        output = Text(f"ERROR DETECTED\n\n" + "\n".join(errors), style="bold red")
        console.print(Group(Text(f"Monitoring: {path}"), output))
    else:
        console.print(render_table(parse_metrics(lines), path))
        console.print("Refreshing every 2 seconds. Press Ctrl-C to exit.", style="dim")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", nargs="?", type=Path, default=DEFAULT_DIRECTORY)
    args = parser.parse_args()
    try:
        log_path = choose_log(args.directory)
        console = Console()
        directory_monitor = DirectoryMonitor(MONITORED_DIRECTORIES)
        directory_monitor.start()
        try:
            with Live(console=console, refresh_per_second=LIVE_REFRESH_PER_SECOND, screen=False) as live:
                wait_for_startup(log_path, live, directory_monitor)
                while True:
                    lines = read_tail(log_path)
                    errors = error_lines(lines)
                    if errors:
                        renderable = Group(Text(f"Monitoring: {log_path}"), Text("\nERROR DETECTED\n\n" + "\n".join(errors), style="bold red"))
                    else:
                        renderable = Group(render_table(parse_metrics(lines), log_path), Text("Refreshing every 2 seconds. Press Ctrl-C to exit.", style="dim"))
                    live.update(renderable)
                    time.sleep(2)
        finally:
            directory_monitor.stop()
    except KeyboardInterrupt:
        print()
    except (FileNotFoundError, OSError) as error:
        raise SystemExit(str(error)) from error


if __name__ == "__main__":
    main()

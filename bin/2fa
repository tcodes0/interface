# generate a TOTP code for a service. print and copy to clipboard.

set -euo pipefail
shopt -s globstar
trap 'err $LINENO' ERR

### vars ###

TFA_DIR="$HOME/.2fa"
COPY_BIN=wl_copy

check_dependencies() {
  if [ "${BASH_ENV:-}" == "" ]; then
    echo "BASH_ENV not set"
    exit 1
  fi

  for dep in gpg oathtool $COPY_BIN; do
    command -v "$dep" >/dev/null || fatal $LINENO "$dep not found"
  done
}

list_services() {
  find "$TFA_DIR" -maxdepth 1 -type f | sort | while read -r f; do
    basename "$f" .gpg
  done
}

help_exit() {
  msgln "Usage: 2fa <service>"
  msgln "valid services:"
  list_services
  exit 1
}

encrypt() {
  local out name recipient="1357rtr@gmail.com"

  while read -r file; do
    name=$(basename "$file")
    out="$file.gpg"
    log $LINENO "encrypting $name"

    gpg --encrypt --recipient "$recipient" --output "$out" "$file" || fatal $LINENO "failed to encrypt $file"
    shred -u "$file"
  done < <(find ~/.2fa -maxdepth 1 -type f -not -name "*.gpg")
}

### script ###

if macos; then
  COPY_BIN=pbcopy
fi

check_dependencies

[ -d "$TFA_DIR" ] || fatal $LINENO "$TFA_DIR not found"

if [ $# -eq 0 ] || requested_help "$*"; then
  help_exit
fi

service="$1"
gpg_file="$TFA_DIR/$service.gpg"
plain_file="$TFA_DIR/$service"

if [ -f "$gpg_file" ]; then
  secret=$(gpg --quiet --decrypt "$gpg_file")
elif [ -f "$plain_file" ]; then
  warn $LINENO "$service is not encrypted"
  secret=$(cat "$plain_file")
else
  err $LINENO "$service not found"
  msgln "valid services:"
  list_services
  exit 1
fi

code=$(oathtool -b --totp - <<<"$secret" | tr -d '\n')

printf '%s\n' "$code"
printf '%s' "$code" | $COPY_BIN

encrypt

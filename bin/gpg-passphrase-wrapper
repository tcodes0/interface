# Canonical gpg-passphrase-wrapper. bin/setup (commit_signing) fetches this file
# instead of regenerating it inline -- this is the single source of truth.
# See doc/ideas/gpg-wrapper-versioning.md. Never hand-edit a deployed copy;
# fix it here and let bin/setup re-fetch it.
_gpg_passphrase="${GPG_PASSPHRASE:-$(cat /run/secrets/gpg_passphrase 2>/dev/null)}"
if [[ -z "${_gpg_passphrase}" && -f /lga/secrets/gpg_passphrase ]]; then
  _gpg_passphrase="$(cat /lga/secrets/gpg_passphrase)"
fi
exec gpg --batch --passphrase "${_gpg_passphrase}" --pinentry-mode loopback "$@"

# pacman system update helper
# note: undefined functions are in lib.sh (sourced via BASH_ENV)

set -euo pipefail
shopt -s globstar
trap 'err $LINENO' ERR
trap 'cleanup_child_processes' EXIT INT TERM

### vars and functions ###

cleanup_processes=()
btrfs_check_pids=()
btrfs_check_log_files=()
btrfs_check_devs=()

check_dependencies() {
  if [ -z "$BASH_ENV" ]; then
    echo "This script uses functions defined externally."
    echo "\$BASH_ENV is used to source dependencies, and is empty."
    echo "If functions are in the environment, please set BASH_ENV to any string."
    exit 1
  fi
}

sudo_refresh() {
  while true; do
    sudo -v
    sleep 240 # 4 minutes
  done
}

do_snapshot() {
  local response

  msgln "start a new @root snapshot? Sudo is necessary (timeout 10s) [y/N] (10s timeout)"
  read -t 10 -r response || true
  if [ "$response" == "y" ] || [ "$response" == "Y" ]; then
    sudo "$HOME/bin/snapshot"
  fi
}

services() {
  local cmd="$1" service

  msgln "$cmd-ing services, sudo is necessary"
  for service in "${@:2}"; do
    sudo systemctl "$cmd" "$service".service
    log $LINENO "$cmd $service"
  done
}

extract_version() {
  if [ ! "$*" ]; then
    err $LINENO "empty version"
    return 1
  fi

  echo -n "$*" | grep -o -E '[0-9]+\.'
}

migrate_postgres() {
  msgln
  log $LINENO "manually migrating pg db across major versions..."
  log $LINENO "sudo required"
  sudo true
  local old_version

  old_version="$(sudo -u postgres cat /var/lib/postgres/data/PG_VERSION)"
  log $LINENO "old version: $old_version"

  # mv and mkdir will fail here if directories exist
  sudo mv /var/lib/postgres/data /var/lib/postgres/olddata
  sudo mkdir /var/lib/postgres/data /var/lib/postgres/tmp
  sudo chown postgres:postgres /var/lib/postgres/data /var/lib/postgres/tmp

  sudo -u postgres bash <<EOF
set -e
cd /var/lib/postgres/tmp
initdb --encoding=UTF8 -D /var/lib/postgres/data
pg_upgrade \
  -b "/opt/pgsql-${old_version}/bin" \
  -B /usr/bin \
  -d /var/lib/postgres/olddata \
  -D /var/lib/postgres/data
EOF
}

refresh_collations() {
  local dbs=(comms comms_test hub hub_test member member_test postgres template1)

  log $LINENO collation update on "${dbs[*]}"

  for db in "${dbs[@]}"; do
    psql -U postgres -c "alter database $db refresh collation version;" >/dev/null || log $LINENO "refresh failed on $db, ignoring"
  done
}

postgres_up() {
  local current_pg_major new_pg_major major_sub

  current_pg_major=$(extract_version psql --version)
  # delete all lines but the 3rd line
  new_pg_major=$(yay --sync --refresh --info postgresql | sed '3!d')
  new_pg_major=$(extract_version "$new_pg_major")

  # .0 is necessary because regex is capturing the dot
  major_sub=$(echo "${new_pg_major}.0 - ${current_pg_major}.0" | bc)
  yay --sync postgresql postgresql-old-upgrade --needed --noconfirm

  if [ "$major_sub" -ge 1 ]; then
    migrate_postgres
    refresh_collations
  else
    log $LINENO "no major version change detected in Postgresql"
  fi
}

system_up() {
  mise_update_globals

  # fix some install errors
  chmod -R u+w,u+r "$HOME/.cache/yay"

  # keep the sudo timestamp alive across long compiles from AUR
  sudo_refresh &
  cleanup_processes+=($!)

  # update arch pkgs first to avoid errors
  yay --sync --refresh --needed --noconfirm archlinux-appstream-data archlinux-keyring
  # update linux
  yay --sync linux linux-api-headers linux-firmware linux-headers --needed --noconfirm
  # update everything but linux from repositories
  yay --repo --sync --sysupgrade --ignore linux,linux-api-headers,linux-firmware,linux-headers --needed --noconfirm

  # update everything but linux from AUR
  if ! yay --aur --sync --sysupgrade --ignore linux,linux-api-headers,linux-firmware,linux-headers --needed --noconfirm; then
    fatal $LINENO failed to update from AUR, try 'yay --aur --sync --sysupgrade --ignore linux,linux-api-headers,linux-firmware,linux-headers --needed' manually
  fi
}

cleanup() {
  local pg_major="$1"

  if [ "$pg_major" ]; then
    # make sure postgresql is restarted successfully before attempting removal
    sudo rm -fr /var/lib/postgres/olddata /var/lib/postgres/tmp
    sudo -u postgres vacuumdb --all --analyze-in-stages
  fi
}

btrfs_check() {
  msgln "checking btrfs on disks: $*"
  msgln "please unmount all partitions from all disks. Type y to continue, anything else to skip."

  read -r response
  if [ "$response" != "y" ] && [ "$response" != "Y" ]; then
    return
  fi

  msgln "sudo required..."
  sudo true

  for disk in "$@"; do
    local dev="/dev/disk/by-label/$disk"
    local log_file="/tmp/btrfs-check-${disk}.log"

    if sudo findmnt --source "$dev" >/dev/null 2>&1; then
      fatal $LINENO "device $dev is still mounted, unmount before running btrfs check"
    fi

    msgln "starting btrfs check on $dev, logging to $log_file"
    sudo btrfs check --check-data-csum "$dev" 2>&1 | sudo tee "$log_file" &
    btrfs_check_pids+=($!)
    btrfs_check_log_files+=("$log_file")
    btrfs_check_devs+=("$dev")
  done
}

btrfs_check_wait() {
  msgln "waiting for all btrfs checks to complete..."
  for i in "${!btrfs_check_pids[@]}"; do
    if ! wait "${btrfs_check_pids[$i]}"; then
      fatal $LINENO "btrfs check failed on ${btrfs_check_devs[$i]} — see ${btrfs_check_log_files[$i]} or run: btrfs check --progress ${btrfs_check_devs[$i]}"
    fi
  done

  msgln "all btrfs checks passed"

  unset btrfs_check_pids
  unset btrfs_check_log_files
  unset btrfs_check_devs
}

cleanup_child_processes() {
  for pid in "${cleanup_processes[@]}"; do
    if ps -p "$pid" >/dev/null; then
      if ! kill -HUP "$pid"; then
        warn $LINENO "failed to hangup process $pid"
      fi
    fi
  done
  unset cleanup_processes
}

# parses [tools] section of mise config and outputs "use --global" commands for each tool
# the reinstall causes mise to pick up the latest versions of the tools.
mise_parse_config_to_commands() {
  grep -A 100 '^\[tools\]' ~/.config/mise/config.toml |
    grep -v '^\[' |
    awk -F'=' '
    NF==2 {
      gsub(/[[:space:]"]/, "", $1)
      gsub(/[[:space:]"]/, "", $2)
      "mise use --global " $1 "@" $2
    }
  '
}

mise_update_globals() {
  mise_parse_config_to_commands | while read -r cmd; do $cmd; done

  # after npm update, reinstall missing npm globals
  local packages=(cspell@latest @commitlint/cli@latest @commitlint/config-conventional@latest)

  for ((i = 0; i < ${#packages[@]}; i++)); do
    npm install --global "${packages[i]}"
  done
}

# Mise configuration file is sim linked into its /root.
# Install packages globally for root.
mise_root_update() {
  sudo mise install
}

# prunes unpinned mise tool versions beyond the keep count
mise_prune_versions() {
  # versions to keep per tool; tools not listed use keep_default
  declare -A keep=([shellcheck]=1 [shfmt]=1)
  # specific versions to always retain, space-separated; e.g. ([node]="22.14.0")
  declare -A keep_versions=([node]="22.22.2")
  local keep_default=0 tool version v i k pinned unpinned_list
  declare -A unpinned

  unpinned_list=$(mise ls --json | python3 -c '
import json, sys
data = json.load(sys.stdin)
for tool, versions in data.items():
    for v in versions:
        if "source" not in v:
            print(tool, v["version"])
')

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    read -r tool version <<<"$line"
    unpinned["$tool"]+="$version "
  done <<<"$unpinned_list"

  for tool in "${!unpinned[@]}"; do
    k="${keep[$tool]:-$keep_default}"
    pinned="${keep_versions[$tool]:-}"
    readarray -t sorted < <(tr ' ' '\n' <<<"${unpinned[$tool]}" | grep -v '^$' | sort -Vr)

    for ((i = k; i < ${#sorted[@]}; i++)); do
      v="${sorted[$i]}"
      if [[ -n "$pinned" ]]; then
        # shellcheck disable=SC2086
        for pv in $pinned; do
          [[ "$pv" == "$v" ]] && continue 2
        done
      fi
      log $LINENO "pruning $tool@$v"
      mise uninstall "${tool}@${v}"
    done
  done
}

cleanup_packages() {
  # 19GB of build dependencies of llama.cpp
  yay --remove --recursive --recursive rocm-hip-sdk --noconfirm
}

### script ###

main() {
  check_dependencies

  do_snapshot
  services stop postgresql

  btrfs_check Data2TB Data4TB

  local pg_update
  pg_update=$(postgres_up)

  mise_update_globals
  mise_root_update
  mise_prune_versions
  system_up
  services start postgresql
  refresh_collations

  cleanup "$pg_update"
  cleanup_packages
  btrfs_check_wait

  success_message
  cleanup_child_processes
}

main
